{
  "name": "javaedit",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only Java IDE on a hardened JavaBox runtime",
  "type": "module",
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "serve": "node scripts/serve.mjs dist 5173",
    "test:unit": "node --test tests/unit/paths.test.mjs",
    "test:host": "node --test tests/host/driver.test.mjs",
    "test": "npm run test:unit && npm run test:host",
    "test:e2e": "playwright test"
  }
}
