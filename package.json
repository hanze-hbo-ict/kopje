{
  "name": "javaedit",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only Java IDE on a hardened JavaBox runtime",
  "type": "module",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dev": "npm run prepare:runtime && vite",
    "build": "npm run prepare:runtime && tsc --noEmit && vite build",
    "serve": "node scripts/serve.mjs dist 5391",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:host": "node --test tests/host/driver.test.mjs",
    "test": "npm run test:unit && npm run test:host",
    "test:e2e": "npm run build:test && playwright test",
    "build:test": "JAVAEDIT_TEST_PAGES=1 npm run build",
    "test:diag": "npm run build:test && DIAG=1 playwright test -diag",
    "verify": "node scripts/verify.mjs",
    "verify:dist": "node scripts/verify.mjs dist"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  }
}
